# EcoTrack/backend/.env.example
# ---------------------------------------------------------------------------
# This file is a TEMPLATE that IS committed to GitHub.
# Copy it to a file named ".env" and fill in the real values there.
# The real ".env" file is git-ignored so your secrets never leave your laptop.
# ---------------------------------------------------------------------------

# Flask session/signing secret. Generate a random one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# "development" enables debug mode locally. Use "production" on Render.
FLASK_ENV=development

# Port the Flask server listens on. Render overrides this automatically.
PORT=5000

# Your Firebase project id (found in Firebase Console > Project settings).
FIREBASE_PROJECT_ID=ecotrack-carbon-tracker

# --- Firebase Admin credentials: choose ONE of the two options below ---

# OPTION A (use this for LOCAL development):
# Download the service account key from
#   Firebase Console > Project settings > Service accounts > Generate new private key
# Save it inside the backend folder as serviceAccountKey.json (already git-ignored)
# and point this variable at it.
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json

# OPTION B (use this on RENDER, where you cannot upload files):
# Open serviceAccountKey.json, copy the WHOLE file contents, and paste it here
# as a single line. Leave it empty when using Option A.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Comma-separated list of frontend URLs allowed to call this API (CORS).
# Add your Firebase Hosting URL here after you deploy the frontend.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- EcoTrack Assistant (optional, powered by Groq) ---
# Free key, no credit card: https://console.groq.com > API Keys > Create API Key
# THIS IS A REAL SECRET. Never commit it, and never put it in frontend/.env -
# only the Flask server should ever hold it.
# Leave blank to run EcoTrack without the assistant; everything else works.
GROQ_API_KEY=

# Which Groq-hosted model powers chat, report summaries, voice logging and
# the AI reduction plan. openai/gpt-oss-120b supports both ordinary
# conversation and strict JSON-schema structured output, which is why one
# model covers every text-only surface.
ASSISTANT_MODEL=openai/gpt-oss-120b

# The bill scanner (routes/ingest.py) needs a model that can read an image,
# which ASSISTANT_MODEL above cannot - qwen/qwen3.8-27b is the one
# Groq-hosted model supporting both vision input and structured output at
# once. Unlike the old Gemini integration, this does NOT read PDFs - only
# JPEG/PNG/WEBP photos.
GROQ_VISION_MODEL=qwen/qwen3.8-27b

# --- Admin access ---
# Comma-separated emails allowed into the admin panel. When set, this is the
# ONLY way to be an admin - exactly these addresses, nothing else. Leave blank
# to fall back to the admins/{uid} Firestore collection.
ADMIN_EMAILS=you@example.com

# --- Razorpay (donations / "Support EcoTrack") ---
# Get TEST keys from the Razorpay Dashboard > Settings > API Keys.
# The SECRET is a REAL secret - keep it here (server-side) only, and NEVER put
# it in frontend/.env or commit it. Leave both blank to run EcoTrack without the
# donation feature (the button simply reports it is unavailable).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# --- Bot protection (optional) ---
# Free, no card: https://www.google.com/recaptcha/admin - register a v3 site.
# THIS IS A REAL SECRET, server-side only - the matching public site key goes
# in frontend/.env as VITE_RECAPTCHA_SITE_KEY instead. Leave blank to run
# EcoTrack without bot checks on Register/Feedback/Donate; everything else
# still works, those forms just skip the extra verification step.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Push notifications (optional) ---
# Sending itself needs no secret - firebase_admin.messaging rides on the
# same service-account credentials FIREBASE_CREDENTIALS_PATH/
# FIREBASE_SERVICE_ACCOUNT_JSON above already provide. This ONE value is
# what stops anyone who finds the cron URL from POSTing it themselves and
# spamming every user - Vercel signs its own scheduled requests with this
# as a Bearer token automatically once it is set as a Vercel env var (not
# just here locally). Generate one the same way as SECRET_KEY above:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to run EcoTrack without it - routes/cron.py's daily streak
# reminder refuses every request rather than running unauthenticated. Also
# needs VITE_FIREBASE_VAPID_KEY set in frontend/.env before any browser can
# actually register to receive one - see utils/pushNotifications.js.
CRON_SECRET=

# EcoTrack/frontend/.env.example
# ---------------------------------------------------------------------------
# This file is a TEMPLATE that IS committed to GitHub.
# Copy it to a file named ".env" and fill in the real values there.
#
# WHERE TO FIND THESE VALUES:
#   Firebase Console > Project settings > General > Your apps > Web app > Config
#
# NOTE: unlike the backend keys, these Firebase web values are not secret - they
# end up inside the JavaScript bundle that every visitor downloads. Firebase is
# designed that way; your data is protected by Firestore Security Rules and by
# the token checks in the Flask backend, not by hiding these values. They still
# live in .env so you can point the app at a different Firebase project without
# editing any code.
#
# IMPORTANT: Vite only exposes variables that start with VITE_
# ---------------------------------------------------------------------------

# The Flask backend. Change this to your Render URL after you deploy.
# Use 127.0.0.1 rather than localhost: on Windows, localhost can resolve to the
# IPv6 address ::1, while Flask listens on IPv4 only, which looks like the
# server being down even when it is running perfectly.
VITE_API_URL=http://127.0.0.1:5000

VITE_FIREBASE_API_KEY=your-api-key-here
# Leave this as the default <project-id>.firebaseapp.com unless you complete
# ALL of the steps below - half-doing this breaks Google Sign-In outright,
# confirmed live in this project TWICE, two different ways:
#
# Google's "Sign in with Google" popup shows whatever authDomain resolves to
# as "to continue to ...", so a nicer Hosting site's .web.app domain (Console
# > Hosting > Add another site) reads better than the raw <project-id>
# string. But changing authDomain alone breaks sign-in, because TWO separate
# registrations both silently default to "off" for a Hosting site that isn't
# the original authDomain - being an authorized Hosting domain does not imply
# either of these:
#   1. Google Cloud Console > Google Auth Platform > Clients > the Web OAuth
#      client Firebase Auth uses (auto-created, named like "Web client (auto
#      created by Google Service)") > add https://<your-new-domain> as an
#      Authorized JavaScript origin AND https://<your-new-domain>/__/auth/handler
#      as an Authorized redirect URI. Skip this and sign-in fails with
#      Error 400: redirect_uri_mismatch, after redirecting to Google.
#   2. Firebase Console > Authentication > Settings > Authorized domains >
#      add <your-new-domain>. Skip this and sign-in fails with "The requested
#      action is invalid" before it ever reaches Google - Firebase's own
#      /__/auth/handler page checks this list first.
# Only after BOTH are done: change authDomain below and redeploy. Also update
# CORS_ORIGINS in the backend's Vercel env vars to include the new frontend
# origin, or API calls from it will fail CORS.
# (This same domain switch does still make the hidden auth iframe same-origin
# with the app, fixing a real Safari third-party-storage risk - it's worth
# doing, just not worth doing out of order.)
VITE_FIREBASE_AUTH_DOMAIN=ecotrack-carbon-tracker.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ecotrack-carbon-tracker
VITE_FIREBASE_STORAGE_BUCKET=ecotrack-carbon-tracker.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id-here
VITE_FIREBASE_APP_ID=your-app-id-here

# --- Push notifications (optional) ---
# Leave blank to run EcoTrack without it; the Profile page's notifications
# toggle simply does not render at all (see utils/pushNotifications.js's
# pushNotificationsConfigured()) rather than showing a broken control.
# Free, no card, at Firebase Console > Project settings > Cloud Messaging >
# Web Push certificates > Generate key pair. Also needs CRON_SECRET set on
# Vercel (backend/.env.example) before the daily streak-reminder job
# actually runs - see backend/routes/cron.py.
VITE_FIREBASE_VAPID_KEY=

# --- Razorpay donation button (public key_id ONLY - never the secret) ---
# The browser needs the key_id to open Razorpay Checkout; it is not secret.
# The KEY_SECRET must NEVER appear in this file - it lives only in backend/.env.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx

# --- Bot protection (optional) ---
# The v3 SITE key only - safe to expose, reCAPTCHA needs it client-side. The
# SECRET key is server-side only and goes in backend/.env instead, never here.
# Leave blank to run EcoTrack without it; Register/Feedback/Donate work the
# same either way, they just skip sending a verification token.
VITE_RECAPTCHA_SITE_KEY=
